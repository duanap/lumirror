# Lumirror direct-server example. Keep the real production file outside the release directory
# (for example: /www/wwwroot/duanap/apps/lumirror/shared/lumirror.env) and chmod it 0600.
APP_ENV=production
APP_VERSION=1.5.1
HOST=127.0.0.1
PORT=3020
DATA_DIR=/www/wwwroot/duanap/apps/lumirror/shared/data

# Generate two different high-entropy secrets. Never reuse either value elsewhere.
ADMIN_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
PUBLIC_TOKEN_SECRET=replace-with-another-different-random-secret-at-least-32-characters

# Required only when bootstrapping a completely empty database. Remove after the first
# administrator has changed the initial password. Existing databases do not require it.
INITIAL_ADMIN_PASSWORD=replace-only-for-first-bootstrap
BOOTSTRAP_DEMO_DATA=false

ALLOWED_ORIGINS=https://lumirror.duanap.cn
SESSION_COOKIE_SECURE=true
ADMIN_SESSION_SECONDS=28800
PUBLIC_SESSION_SECONDS=7200
TIMED_INVITE_SECONDS=300

# Nginx is expected to proxy from the same host to 127.0.0.1:3020. Forwarded client
# addresses are trusted only from a loopback peer unless this is explicitly changed.
TRUST_PROXY=loopback
